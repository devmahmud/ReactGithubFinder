# GitHub API Configuration
# Get these from: https://github.com/settings/applications/new

# GitHub OAuth App Client ID
VITE_REACT_APP_CLIENT_ID=your_github_client_id_here

# GitHub OAuth App Client Secret
VITE_REACT_APP_CLIENT_SECRET=your_github_client_secret_here

# Optional: GitHub Personal Access Token (alternative to client ID/secret)
# Get from: https://github.com/settings/tokens
# GITHUB_TOKEN=your_personal_access_token_here
